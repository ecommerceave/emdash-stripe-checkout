{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "emdash-stripe-checkout",
	"publisher": "did:plc:wlshattmcjplayfxlgzbhxvk", // ecommerceave.com

	"license": "MIT",

	"name": "Stripe Checkout for EmDash",
	"description": "Accept payments through Stripe Checkout with a simple e-commerce integration for EmDash.",

	"keywords": [
	"stripe",
	"stripe checkout",
	"payments",
	"ecommerce",
	"online store"
	],

	"sections": {
		"description": "Stripe Checkout for EmDash connects your EmDash website with Stripe, providing a foundation for accepting online payments through Stripe's hosted checkout experience.\n\n### Features\n\n- Connect your Stripe account using a secret API key.\n- Configure the integration from your EmDash admin dashboard.\n- Integrate with Stripe's hosted checkout experience.\n\n### Getting Started\n\nInstall the plugin and configure your Stripe API key in the EmDash admin dashboard. We recommend using a Stripe test-mode key during initial setup.\n\n### About eCommerce Ave\n\nDeveloped by [eCommerce Ave](https://ecommerceave.com), creating practical integrations and e-commerce tools for EmDash."
	},

	"author": {
	"name": "eCommerce Ave",
	"url": "https://ecommerceave.com"
	},

	"security": { "email": "support@ecommerceave.com" },
	"repo": "https://github.com/ecommerceave/emdash-stripe-checkout",

	// Trust contract — what runtime APIs the plugin asks for.
	// Empty arrays mean no extra privileges beyond logging,
	// KV, and route/hook registration. Changing these between
	// releases requires a version bump because installed
	// users have consented to the old contract.
	"capabilities": [
		"network:request",
		"content:write",
		"media:read",
		"schema:read"
	],

	"allowedHosts": [
		"api.stripe.com"
	],

	"storage": {
		"orders": {
			"indexes": [
			"paymentStatus",
			"createdAt",
			"productId"
			],
			"uniqueIndexes": [
			"stripeSessionId"
			]
		}
	},

	"admin": {
        "settingsSchema": {
			"stripeSecretKey": {
				"label": "Stripe Secret Key",
				"description": "Your Stripe secret API key. Use a test-mode key while setting up and testing the plugin.",
				"type": "secret"
			},
			"stripeWebhookSecret": {
				"label": "Stripe Webhook Signing Secret",
				"description": "The webhook signing secret provided by Stripe (starts with whsec_). Used to verify incoming Stripe webhook events.",
				"type": "secret"
			}
		},
		"pages": [
			{
				"path": "/stripe-checkout",
				"label": "Stripe Checkout"
			}
		]
	}
}

{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "emdash-stripe-checkout",
	"publisher": "did:plc:wlshattmcjplayfxlgzbhxvk", // ecommerceave.com

	"license": "MIT",

	"name": "Stripe Checkout for EmDash",
	"description": "Accept payments through Stripe Checkout with a simple e-commerce integration for EmDash.",

	"keywords": [
	"stripe",
	"stripe checkout",
	"payments",
	"ecommerce",
	"online store"
	],

	"sections": {
		"description": "Stripe Checkout for EmDash is a lightweight e-commerce integration that lets you accept payments through Stripe's secure hosted checkout experience without needing a full e-commerce platform.\n\n### Features\n\n- Connect your Stripe account using a secret API key.\n- Accept payments securely through Stripe Checkout.\n- Manage products using configurable EmDash Content Types.\n- Integrate Buy Now buttons and payment verification using reusable storefront helpers.\n- View customer orders and payment statuses in your EmDash dashboard.\n- Track customer information, purchased products, quantities, and order totals.\n- Automatically update payment statuses using Stripe webhooks.\n- Track full and partial refunds initiated through Stripe.\n- View refund history, refunded amounts, and remaining balances.\n- Synchronize missing order details with Stripe.\n- Support Stripe test and live modes.\n\n### Getting Started\n\nInstall the plugin and configure your Stripe Secret Key and Webhook Signing Secret in the EmDash admin dashboard. We recommend starting with Stripe test mode to verify your checkout and webhook configuration before accepting live payments.\n\nRefunds are initiated through the Stripe Dashboard and automatically synchronized with EmDash through verified webhook events.\n\n### About eCommerce Ave\n\nDeveloped by [eCommerce Ave](https://ecommerceave.com), creating practical integrations and e-commerce tools for EmDash."
	},

	"author": {
	"name": "eCommerce Ave",
	"url": "https://ecommerceave.com"
	},

	"security": { "email": "support@ecommerceave.com" },
	"repo": "https://github.com/ecommerceave/emdash-stripe-checkout",

	// Trust contract — what runtime APIs the plugin asks for.
	// Empty arrays mean no extra privileges beyond logging,
	// KV, and route/hook registration. Changing these between
	// releases requires a version bump because installed
	// users have consented to the old contract.
	"capabilities": [
		"network:request",
		"content:write",
		"media:read",
		"schema:read"
	],

	"allowedHosts": [
		"api.stripe.com"
	],

	"storage": {
		"orders": {
			"indexes": [
			"paymentStatus",
			"createdAt",
			"productId"
			],
			"uniqueIndexes": [
			"stripeSessionId"
			]
		}
	},

	"admin": {
        "settingsSchema": {
			"stripeSecretKey": {
				"label": "Stripe — Secret Key",
				"description": "Your Stripe secret API key. Use a test-mode key while setting up and testing the plugin.",
				"type": "secret"
			},
			"stripeWebhookSecret": {
				"label": "Stripe — Webhook Signing Secret",
				"description": "The webhook signing secret provided by Stripe (starts with whsec_). Used to verify incoming Stripe webhook events.",
				"type": "secret"
			},
			"productContentTypeSlug": {
				"label": "Products — Content Type Slug",
				"description": "The slug of the EmDash Content Type containing your products. Default: products.",
				"type": "string",
				"default": "products"
			}
		},
		"pages": [
			{
				"path": "/stripe-checkout",
				"label": "Stripe Checkout"
			}
		]
	}
}
